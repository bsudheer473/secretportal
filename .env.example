# AWS Configuration
AWS_REGION=us-east-1

# DynamoDB Tables
SECRETS_METADATA_TABLE=secrets-metadata
AUDIT_LOG_TABLE=secrets-audit-log

# Cognito
USER_POOL_ID=us-east-1_XXXXXXXXX
CLIENT_ID=your_client_id_here

# Cross-Account Secrets Access
# Set this to the role ARN in the secrets account (Account B)
# Leave empty to use secrets in the current account
CROSS_ACCOUNT_ROLE_ARN=arn:aws:iam::123456789012:role/SecretsPortalCrossAccountRole
CROSS_ACCOUNT_REGION=us-east-1

# SNS (optional)
SNS_TOPIC_ARN=

# Teams Notifications (optional)
USE_TEAMS_NOTIFICATIONS=false
TEAMS_WEBHOOK_URL=
PORTAL_URL=https://your-amplify-url.amplifyapp.com

# Frontend Environment Variables (set in Amplify Console)
# VITE_API_ENDPOINT=https://abc123.execute-api.us-east-1.amazonaws.com/prod
# VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
# VITE_USER_POOL_CLIENT_ID=your_client_id
# VITE_AWS_REGION=us-east-1
